# dependencies
node_modules/
credentials/
# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
@*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (keep .env out of repo - use .env.example as template)
.env
.env*.local

# typescript
*.tsbuildinfo

# iOS - fully generated, no native customisations
/ios

# Android - fully generated by `expo prebuild` from app.config.js and
# plugins/ (the ABI splits and release signing come from
# plugins/withAbiSplits.js). Not committed: a committed copy goes stale and,
# when present, EAS skips prebuild, so config-plugin changes (Firebase, the
# lock-screen alert permissions) never reach the build. 2026-10-05.
# scripts/build-apk-with-env.js regenerates it before every release build.
/android
.android-signing/

# Claude Code
.claude/

# Firebase Android app config — contains project identifiers, not committed
google-services.json

# Play Console service-account key used by `eas submit` — never commit
google-service-account.json
